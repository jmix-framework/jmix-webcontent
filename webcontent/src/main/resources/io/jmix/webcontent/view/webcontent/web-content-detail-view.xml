<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://webContentDetailView.title"
      focusComponent="form">
    <data>
        <instance id="webContentDc"
                  class="io.jmix.webcontent.entity.WebContent">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="webContentDc">
            <textField id="titleField" property="title"/>
            <textField id="slugField" property="slug"/>
            <textField id="langField" property="lang"/>
            <comboBox id="typeField" property="type" required="true"/>
        </formLayout>

        <!-- Exactly one editor is visible at a time, driven by typeField; see WebContentDetailView. -->
        <markdownEditor id="sourceField"
                        dataContainer="webContentDc"
                        property="source"
                        label="msg://io.jmix.webcontent.entity/WebContent.source"
                        helperText="msg://sourceField.helperText"
                        width="100%"
                        height="30em"/>
        <textArea id="contentsField"
                  dataContainer="webContentDc"
                  property="contents"
                  label="msg://io.jmix.webcontent.entity/WebContent.contents"
                  width="100%"
                  height="20em"/>

        <hbox id="detailActions">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>
